# Copy to server/.env and fill in. server/.env is git-ignored.

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# How often (minutes) EscalationScheduler escalates overdue complaints and auto-closes resolved ones.
# Use 0 to turn the timer off, e.g. during the live demo so the admin "Run deadline check" button does the work.
DEADLINE_CHECK_MINUTES=15

# Database. DB_ADMIN_* is only used by `npm run setup` to create the
# database and the application user; the app itself connects with DB_USER / DB_PASSWORD.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campusfix
DB_USER=campusfix
DB_PASSWORD=change-me
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# Auth (the server will not start without a JWT_SECRET)
JWT_SECRET=change-me-to-a-long-random-string
