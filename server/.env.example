# Copy to server/.env and fill in. server/.env is git-ignored.

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Deadline check interval (minutes) for EscalationScheduler (used from M6)
DEADLINE_CHECK_MINUTES=15

# Database (used from M1). DB_ADMIN_* is only used by `npm run setup` to create the
# database and the application user; the app itself connects with DB_USER / DB_PASSWORD.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campusfix
DB_USER=campusfix
DB_PASSWORD=change-me
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# Auth (used from M3)
JWT_SECRET=change-me-to-a-long-random-string
